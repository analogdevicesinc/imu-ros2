<codeline lineno="74"><highlight class="normal"><sp/><sp/><sp/><sp/>filter.mean<sp/>=<sp/>(1.0<sp/>-<sp/>MEAN_ALPHA)<sp/>*<sp/>filter.mean<sp/>+<sp/>MEAN_ALPHA<sp/>*<sp/>sample;</highlight></codeline>
<codeline lineno="75"><highlight class="normal"><sp/><sp/>}</highlight></codeline>
<codeline lineno="76"><highlight class="normal"></highlight></codeline>
<codeline lineno="77"><highlight class="normal"><sp/><sp/></highlight><highlight class="comment">//<sp/>Compute<sp/>squared<sp/>residual<sp/>as<sp/>measurement<sp/>of<sp/>variance</highlight><highlight class="normal"></highlight></codeline>
